{
  "realm": "aisystem",
  "enabled": true,
  "displayName": "AISystem",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": false,
  "sslRequired": "none",
  "groups": [
    {
      "name": "dev",
      "path": "/dev"
    },
    {
      "name": "boss",
      "path": "/boss"
    }
  ],
  "users": [
    {
      "username": "boss",
      "enabled": true,
