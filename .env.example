# ============================================================
# AISystem 环境变量（复制为 .env 后按需修改）
# 用法: cp .env.example .env
# ============================================================

# ---------- 全局 ----------
TZ=Asia/Shanghai
# 统一入口域名后缀（*.localhost 在现代浏览器中自动解析到 127.0.0.1；
# 若解析失败，请把各子域名写入 hosts 文件）
BASE_DOMAIN=localhost
HTTP_PORT=80

# 数据根目录（NFR-008）：所有服务数据显式挂载到 <DATA_ROOT>/<服务名>
# WSL 部署建议指向 WSL 原生文件系统（如 ~/aisystem-data），避免 /mnt/c 性能与权限问题
DATA_ROOT=./data

# ---------- PostgreSQL（共享数据库实例，各服务分库） ----------
POSTGRES_USER=aisys
POSTGRES_PASSWORD=aisys_pg_change_me

# ---------- Keycloak（SSO） ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_change_me
# OIDC 客户端密钥（与 keycloak/realm/aisystem-realm.json 中保持一致）
OIDC_GITEA_SECRET=gitea-oidc-secret-change-me
OIDC_OUTLINE_SECRET=outline-oidc-secret-change-me

# ---------- Gitea ----------
GITEA_ADMIN_USER=gitea_admin
GITEA_ADMIN_PASSWORD=gitea_admin_change_me
GITEA_SSH_PORT=2222

# ---------- Jenkins ----------
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=jenkins_admin_change_me

# ---------- Outline（知识库 Web） ----------
OUTLINE_SECRET_KEY=outline_secret_key_change_me_0123456789abcdef
OUTLINE_UTILS_SECRET=outline_utils_secret_change_me_0123456789abcdef

# ---------- OpenProject ----------
OPENPROJECT_SECRET_KEY_BASE=openproject_secret_base_change_me_0123456789abcdef0123456789abcdef
# 手工导出用（ADR-0014，scripts/export-openproject.sh）：
# 在 OpenProject「我的账户 → 访问令牌」生成，可留空后补
OPENPROJECT_API_KEY=

# ---------- Manager（管理服务） ----------
OIDC_MANAGER_SECRET=manager-oidc-secret-change-me
MANAGER_SESSION_SECRET=manager_session_secret_change_me_0123456789
ATR_API_TOKEN=atr_token_change_me

# ---------- SSHwifty Web 终端（P0 人机终端，ADR-0030） ----------
# 浏览器仅走 HTTP/WS（ssh.localhost），SSH 腿只在后端容器↔本机/docker 网络内
SSHWIFTY_HOSTNAME=ssh.localhost
SSHWIFTY_SHAREDKEY=sshwifty_change_me
# true 时仅允许连接下方 Presets 预置目标；Presets 会明文发给浏览器，严禁含密码/私钥
SSHWIFTY_ONLYALLOWPRESETREMOTES=false
# 例：P0 目标=宿主 sshd（ADR-0031），Host 用 host.docker.internal:22：
# SSHWIFTY_PRESETS=[{"Title":"host","Type":"SSH","Host":"host.docker.internal:22","Meta":{"User":"你的Windows用户名","Authentication":"Password"}}]

# ---------- Chronicler（supervisor，宿主侧进程，ADR-0020） ----------
CHRONICLER_SECRET=chronicler_session_secret_change_me_0123456789
# 鉴权后端：local（本地账密，零依赖默认）| oidc（统一认证，需先 bash scripts/wire-chronicler.sh）
CHRONICLER_AUTH_BACKEND=local
CHRONICLER_OIDC_SECRET=chronicler-oidc-secret-change-me

# ---------- LLM / Agent（供后续 Agent 任务使用，可留空后补） ----------
# LLM_API_KEY 同时是 manager/agents.yaml 中 api_key_ref 的解析来源：
# 创建 agent 会话时由 Manager 读取并注入 ATR 会话环境（不落明文到注册表）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
